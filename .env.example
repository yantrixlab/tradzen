# Tradzen settings for a hosted server. Copy this file to ".env" (never share or commit it) and fill in the first four.

# The address people will open, without https:// (its DNS record must already point at this server).
QXS_DOMAIN=signals.example.com

# The admin account. It is created / updated from these two lines every time the server starts.
# To change the admin password later: edit it here and run  docker compose up -d
QXS_ADMIN_USER=admin
QXS_ADMIN_PASSWORD=change-this-to-a-long-unique-password

# Random secret that protects sign-in sessions and tokens (16+ characters). Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everybody out.
QXS_SECRET_KEY=

# ---- optional --------------------------------------------------------------------------------------------------------------------
# Nightly backup of every database into the data volume (backups/ folder): on | off, the hour (UTC), how many to keep.
QXS_BACKUP=on
QXS_BACKUP_HOUR=4
QXS_BACKUP_KEEP=7

# One Tradzen account <-> one Quotex account: the first Quotex account an extension sees is tied to its Tradzen account; trades, balance and alerts of any other
# Quotex account are refused (an admin can unlink on the Users page). on | off
QXS_QUOTEX_LINK=on

# Shared candles: every signed-in extension may add the chart history its Quotex page loads to the one candle store (candles the server already has are never changed;
# batches over the per-account / server limits are refused). The admin can pause or remove one account's contributions (Data -> Shared candles). on | off
QXS_CONTRIB=on

# Real-market candles for the AI advisor are downloaded from Yahoo by the server. off = never (some hosts cannot reach it).
QXS_MARKETDATA=on

# Background jobs (they run at low priority; switch off what you do not need on a small server).
QXS_AI=on
QXS_RISK_NIGHTLY=on
QXS_AUTO_UPGRADE=on
QXS_EDGELAB_AUTO=on
QXS_EDGELAB_WEEKLY=on
QXS_RESEARCH_HOUR=3

# The public landing page (shown to visitors who are not signed in) has a "Request access" button when this is set:
# a mailto: link or an https:// link (a contact form, a Telegram / WhatsApp link ...). Accounts are created by the admin.
QXS_CONTACT=

# Memory limit of the backend container.
QXS_MEM_LIMIT=2g
