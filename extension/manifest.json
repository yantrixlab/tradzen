{
  "manifest_version": 3,
  "name": "Tradzen Sniffer",
  "version": "0.8.0",
  "description": "Read-only observer for your own logged-in Quotex tab: sends market data to your local Tradzen backend and shows its signals as on-page alerts with sound. Never trades, clicks or logs in.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "sidePanel", "offscreen", "notifications"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Tradzen", "default_popup": "popup.html",
              "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": [
        "https://*.quotex.com/*", "https://quotex.com/*",
        "https://*.qxbroker.com/*", "https://qxbroker.com/*",
        "https://*.quotex.io/*", "https://quotex.io/*",
        "https://*.market-qx.pro/*", "https://market-qx.pro/*"
      ],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.quotex.com/*", "https://quotex.com/*",
        "https://*.qxbroker.com/*", "https://qxbroker.com/*",
        "https://*.quotex.io/*", "https://quotex.io/*",
        "https://*.market-qx.pro/*", "https://market-qx.pro/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.quotex.com/*", "https://quotex.com/*",
        "https://*.qxbroker.com/*", "https://qxbroker.com/*",
        "https://*.quotex.io/*", "https://quotex.io/*",
        "https://*.market-qx.pro/*", "https://market-qx.pro/*"
      ],
      "js": ["sound.js", "notify.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
