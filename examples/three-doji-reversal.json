          { "label": "Red doji #2 (body stays above doji #1's low)", "color": "red", "shape": "weak", "min": 1, "max": 1,
            "rels": [ { "prop": "open", "op": ">", "ref": 1, "refprop": "low", "scope": "each" },
                      { "prop": "close", "op": ">", "ref": 1, "refprop": "low", "scope": "each" } ] },
          { "label": "Red doji #3 (body stays above doji #1's low)", "color": "red", "shape": "weak", "min": 1, "max": 1,
            "rels": [ { "prop": "open", "op": ">", "ref": 1, "refprop": "low", "scope": "each" },
                      { "prop": "close", "op": ">", "ref": 1, "refprop": "low", "scope": "each" } ] },
          { "label": "Green confirmation candle (BUY signal)", "color": "green", "shape": "any", "min": 1, "max": 1,
            "rels": [ { "prop": "close", "op": ">", "ref": "prev", "refprop": "open", "scope": "each" } ] }
        ]
      },
      "put": {
        "steps": [
          { "label": "Uptrend (green, higher highs)", "color": "green", "shape": "any", "min": 2, "max": 6,
