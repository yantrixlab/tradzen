          { "label": "Green doji #1 (its high is the line to hold)", "color": "green", "shape": "weak", "min": 1, "max": 1, "rels": [] },
          { "label": "Green doji #2 (body stays below doji #1's high)", "color": "green", "shape": "weak", "min": 1, "max": 1,
            "rels": [ { "prop": "open", "op": "<", "ref": 1, "refprop": "high", "scope": "each" },
                      { "prop": "close", "op": "<", "ref": 1, "refprop": "high", "scope": "each" } ] },
          { "label": "Green doji #3 (body stays below doji #1's high)", "color": "green", "shape": "weak", "min": 1, "max": 1,
            "rels": [ { "prop": "open", "op": "<", "ref": 1, "refprop": "high", "scope": "each" },
                      { "prop": "close", "op": "<", "ref": 1, "refprop": "high", "scope": "each" } ] },
          { "label": "Red confirmation candle (SELL signal)", "color": "red", "shape": "any", "min": 1, "max": 1,
            "rels": [ { "prop": "close", "op": "<", "ref": "prev", "refprop": "open", "scope": "each" } ] }
